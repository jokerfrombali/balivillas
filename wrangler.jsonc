{
  "name": "thebalihost",
  "compatibility_date": "2026-07-28",

  // Worker serves /api/* (leads -> Telegram, stats, alerts) and hands
  // everything else to the static assets. See worker/index.js
  "main": "worker/index.js",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // unknown paths get /404.html with a real 404 status
    "not_found_handling": "404-page",

    // Без этого запрос, попавший в файл, отдаётся напрямую и воркер не
    // вызывается вовсе. Из-за этого не работала подшивка скриптов цен и
    // календаря: страницы вилл и каталог никогда её не получали.
    // Список — только страницы; картинки, шрифты и статика идут мимо воркера,
    // как и раньше, иначе каждый файл стоил бы вызова.
    "run_worker_first": [
      "/*",
      "!/public-objects/*",
      "!/images/*",
      "!/fonts/*",
      "!/brand/*",
      "!/villa/assets/*",
      "!/*.js",
      "!/*.css",
      "!/*.json",
      "!/*.xml",
      "!/*.txt",
      "!/*.map",
      "!/*.jpg",
      "!/*.jpeg",
      "!/*.png",
      "!/*.avif",
      "!/*.webp",
      "!/*.gif",
      "!/*.svg",
      "!/*.ico",
      "!/*.woff2",
      "!/*.mp4"
    ]
  },

  // ticket counter + daily view counters
  "kv_namespaces": [
    { "binding": "THB_STATS", "id": "8a6553c66b67411ea2c2093702734ef5" }
  ],

  // chat coordinates are not secret; the bot token lives in the
  // TELEGRAM_TOKEN secret and never in this file
  "vars": {
    "TG_CHAT": "-1003961611036",
    "TG_TOPIC_LEADS": "2",
    "TG_TOPIC_OPS": "4",
    // GA4 property with the G-PF1FJQN7ME stream; the service-account key is in
    // the GA_SA_KEY secret
    "GA_PROPERTY_ID": "550710445"
  },

  // uptime check every 30 min; weekly digest Mon 08:00 WITA (Mon 00:00 UTC)
  "triggers": { "crons": ["*/30 * * * *"] }
}

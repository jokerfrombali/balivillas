.scroll-shadow-left{-webkit-mask-image:linear-gradient(270deg,#fff max(100% - 80px,80%),#0000 max(100% - 10px,95%));mask-image:linear-gradient(270deg,#fff max(100% - 80px,80%),#0000 max(100% - 10px,95%))}.scroll-shadow-right{-webkit-mask-image:linear-gradient(90deg,#fff max(100% - 80px,80%),#0000 max(100% - 10px,95%));mask-image:linear-gradient(90deg,#fff max(100% - 80px,80%),#0000 max(100% - 10px,95%))}.scroll-shadow-left.scroll-shadow-right{-webkit-mask-image:linear-gradient(90deg,#0000 0%,#fff 10% 90%,#0000 100%);mask-image:linear-gradient(90deg,#0000 0%,#fff 10% 90%,#0000 100%)}.scroll-shadow-left.\!opacity-100 button,.scroll-shadow-right.\!opacity-100 button{pointer-events:auto!important}

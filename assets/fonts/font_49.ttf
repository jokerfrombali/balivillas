.carousel-grid-container{container-type:inline-size}.carousel-grid{--width:calc(100cqi / var(--cols));display:flex}.carousel-grid>*{width:var(--width);box-sizing:border-box;scroll-snap-stop:normal;flex:none}@media not (min-width:65rem){.carousel-grid>*{scroll-snap-align:start}}@media (min-width:65rem) and (not (min-width:80.5rem)){.carousel-grid>:nth-of-type(4n+1){scroll-snap-align:start}}@media (min-width:80.5rem) and (not (min-width:104.75rem)){.carousel-grid>:nth-of-type(5n+1){scroll-snap-align:start}}@media (min-width:104.75rem){.carousel-grid>:nth-of-type(6n+1){scroll-snap-align:start}}
